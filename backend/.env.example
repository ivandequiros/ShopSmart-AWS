# Copy to backend/.env and fill in real values. Never commit backend/.env.
DATABASE_URL="postgresql://shopsmart_user:CHANGE_ME@localhost:5432/shopsmart?schema=public"
PORT=3000
# Local: http://localhost:5173   EC2: https://your-name.duckdns.org
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Optional. Leave blank to use the labeled rule-based fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
